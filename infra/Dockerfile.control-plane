# AutomIT Control Plane — TypeScript Agent SDK
# Locked-down headless agent: dontAsk + fixed allowedTools
FROM node:22-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files and install
COPY apps/control-plane/package.json apps/control-plane/package-lock.json* ./
RUN npm install --omit=dev 2>/dev/null || echo "No package-lock yet, skipping install"

# Copy application code
COPY apps/control-plane/dist ./dist

# Copy shared schemas
COPY packages/schemas/dist ./node_modules/@automit/schemas/dist
COPY packages/schemas/package.json ./node_modules/@automit/schemas/

# Copy policy files
COPY packages/policies ./policies

# Non-root user
USER node

EXPOSE 3001
CMD ["node", "dist/index.js"]
