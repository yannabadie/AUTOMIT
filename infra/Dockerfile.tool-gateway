# AutomIT Tool Gateway — Python FastAPI
# Deterministic adapters for GLPI, ERP (MCP), M365, AD
FROM python:3.12-slim

# Install ODBC driver for SQL Server connectivity
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl gnupg2 unixodbc-dev ca-certificates && \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | \
      gpg --dearmor -o /usr/share/keyrings/ms.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/ms.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql17 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Corporate CA (if present)
COPY infra/ca-bundle.pem /usr/local/share/ca-certificates/corporate-ca.crt
RUN update-ca-certificates 2>/dev/null || true

WORKDIR /app

# Install Python dependencies
COPY services/tool-gateway/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY services/tool-gateway/ .

# Copy shared schemas (JSON Schema for Python validation)
COPY packages/schemas/dist/*.schema.json ./schemas/

# Copy policy files
COPY packages/policies ./policies

# Non-root user
RUN useradd -r -s /bin/false appuser
USER appuser

EXPOSE 3002
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3002"]
