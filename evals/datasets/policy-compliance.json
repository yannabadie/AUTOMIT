          "target": {
            "type": "glpi_ticket",
            "id": "42",
            "display_name": "Ticket #42"
          },
          "requestor": {
            "glpi_user_id": 1,
            "profile": "Super-Admin",
            "entity": "Root Entity",
            "interface": "central",
            "right": "plugin_automit_execute"
          },
          "idempotency_key": "00000000-0000-0000-0000-000000000002",
          "ttl_seconds": 300,
          "issued_at": 2000000000,
          "justification": "Policy compliance test"
        },
        "timestamp": 2000000000
      },
      "expected": {"allowed": true}
    },
