{
  "description": "Policy engine compliance test cases",
  "version": "1.0.0",
  "test_cases": [
    {
      "id": "T0-001",
      "name": "Tier 0 read-only always allowed",
      "input": {
        "action": {
          "action_id": "get_ticket",
          "tier": 0,
          "target": {
            "type": "glpi_ticket",
            "id": "42",
            "display_name": "Ticket #42"
          },
          "requestor": {
            "glpi_user_id": 1,
            "profile": "Super-Admin",
            "entity": "Root Entity",
            "interface": "central"
          },
          "idempotency_key": "00000000-0000-0000-0000-000000000001",
          "ttl_seconds": 300,
          "issued_at": 2000000000,
          "justification": "Policy compliance test"
        },
        "timestamp": 2000000000
      },
      "expected": {"allowed": true}
    },
    {
      "id": "T1-001",
      "name": "Tier 1 followup allowed with right",
      "input": {
